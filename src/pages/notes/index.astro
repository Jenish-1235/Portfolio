---
import Layout from '../../layouts/Layout.astro';
import { getNotes } from '../../lib/notion';
import site from '../../data/site.json';

const notes = await getNotes();
const { title, description, emptyMessage } = site.pages.notes;
---

<Layout title={title} description={description}>
  <section class="section">
    <h1>{title}</h1>
    <p>{description}</p>
    <hr />
    {notes.length > 0 ? (
      <div class="posts-list">
        {notes.map((note) => (
          <div class="card">
            <h2><a href={`/notes/${note.slug}`}>{note.title}</a></h2>
            <p class="meta">{note.date}</p>
            <div class="note-actions">
              <a href={`/notes/${note.slug}`} class="btn">View Notes &rarr;</a>
              {note.pdfUrl && (
                <a href={note.pdfUrl} target="_blank" rel="noopener noreferrer" class="btn">Open PDF</a>
              )}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p><em>{emptyMessage}</em></p>
    )}
  </section>
</Layout>
