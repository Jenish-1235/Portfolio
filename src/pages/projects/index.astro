---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/notion';
import site from '../../data/site.json';
import projectsData from '../../data/projects.json';

const writeups = await getProjects();
const { title, description, writeupsTitle } = site.pages.projects;
---

<Layout title={title} description={description}>
  <section class="section">
    <h1>{title}</h1>
    <p>{description}</p>
    <hr />
    <div class="posts-list">
      {projectsData.featured.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  {writeups.length > 0 && (
    <section class="section">
      <h2>{writeupsTitle}</h2>
      <div class="posts-list">
        {writeups.map((project) => (
          <div class="card">
            <h3><a href={`/projects/${project.slug}`}>{project.title}</a></h3>
            <p class="meta">{project.date}</p>
            <a href={`/projects/${project.slug}`} class="btn">Read More &rarr;</a>
          </div>
        ))}
      </div>
    </section>
  )}
</Layout>
